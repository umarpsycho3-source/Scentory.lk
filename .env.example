# ==============================================================================
# SCENTORY.LK - Environment Configuration Template
# ==============================================================================
# In production on Vercel, set these in:
# Project Settings -> Environment Variables -> Production & Preview
#
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO GITHUB.
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/scentory?retryWrites=true&w=majority
MONGODB_URI=

# Strong JSON Web Token Signing Secret (Minimum 32 characters recommended)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Node Environment
NODE_ENV=production
